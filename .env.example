# Only the live commands read .env. The checks and `make cycle` need no key and never read it.

# Each model is provider:model, or provider:model:effort for an OpenAI model's reasoning effort
# (for example openai:gpt-6.1-terra:high). With no effort named, none is sent and the model's
# own default applies. Priced models, and the efforts each takes, are in modelkit/prices.py.
# The triage agent's model; the gate's held-out trials run on it too.
TRIAGE_MODEL=
# The curator's model. Each curator run records it. It is never the model that wrote the
# held-out cases' expected notes: a curator is not tested by its own answers.
CURATOR_MODEL=
# The key of each provider a model above names. Only the agent on that model is given it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# `make cycle` makes everything else itself, in .local/, which git ignores: WEALTHCONTEXT_TOKEN,
# PLAYBOOKS_ANALYST_TOKEN, PLAYBOOKS_OWNER_TOKEN, TRIAGE_AGENT_KEY, CURATOR_KEY,
# TRIAGE_MAX_DOLLARS and CURATOR_MAX_DOLLARS.
